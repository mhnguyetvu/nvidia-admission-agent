# ── NVIDIA RAG Blueprint endpoints ──────────────────────────────────
RAG_URL=http://localhost:8081
INGEST_URL=http://localhost:8082

# Default endpoint paths (change if your blueprint differs)
RAG_SEARCH_PATH=/search
RAG_GENERATE_PATH=/generate
INGEST_DOCUMENTS_PATH=/documents

# Default RAG collection
RAG_COLLECTION=admissions_fall_2026

# ── LLM for agent synthesis (OpenAI-compatible) ───────────────────
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=meta/llama-3.1-70b-instruct

# ── App settings ───────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=9000
REQUEST_TIMEOUT=60
LOG_LEVEL=INFO
