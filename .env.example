# ── VNPay GenAI Configuration ─────────────────────────────────
# Get your JWT token from VNPay GenAI Platform

# LLM: GLM 4.5 Air 110B (Vietnamese + English support)
LLM_BASE_URL= "your base url here"
LLM_API_KEY="your token here"
LLM_MODEL="your model name here"

# Embeddings: BGE m3 (1024 dims, 8192 token window)
EMBEDDING_BASE_URL="your base url here"
EMBEDDING_API_KEY="your token here"
EMBEDDING_MODEL="your model name here"

# ── ChromaDB Local Storage ────────────────────────────────────
CHROMA_DIR=./chroma_data
RAG_COLLECTION=admissions_fall_2026

# ── Chunking Configuration ────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── App Settings ──────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=7777
REQUEST_TIMEOUT=60
LOG_LEVEL=INFO
