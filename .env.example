# ── Backend mode ────────────────────────────────────────────────
# "local" = ChromaDB + PyMuPDF (no GPU needed, runs on laptop)
# "nvidia" = NVIDIA RAG Blueprint (requires rag-server + ingestor-server)
BACKEND=local

# ── Local mode settings ────────────────────────────────────────
CHROMA_DIR=./chroma_data
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── NVIDIA RAG Blueprint endpoints (only for BACKEND=nvidia) ──
RAG_URL=http://localhost:8081
INGEST_URL=http://localhost:8082
RAG_SEARCH_PATH=/search
RAG_GENERATE_PATH=/generate
INGEST_DOCUMENTS_PATH=/documents

# ── Shared RAG settings ───────────────────────────────────────
RAG_COLLECTION=admissions_fall_2026

# ── LLM for agent synthesis (OpenAI-compatible) ───────────────
# Point to your self-hosted LLM endpoint
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=meta/llama-3.1-70b-instruct

# ── App settings ──────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=9000
REQUEST_TIMEOUT=60
LOG_LEVEL=INFO
